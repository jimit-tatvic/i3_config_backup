 /* wallust template - colors-rofi */

* {
active-background: #CBA939;
active-foreground: #ABFCFE;
normal-background: #2A1E1C;
normal-foreground: #ABFCFE;
urgent-background: #F79459;
urgent-foreground: #ABFCFE;

alternate-active-background: #F25E5E;
alternate-active-foreground: #ABFCFE;
alternate-normal-background: #2A1E1C;
alternate-normal-foreground: #ABFCFE;
alternate-urgent-background: #2A1E1C;
alternate-urgent-foreground: #ABFCFE;

selected-active-background: #CBA939;
selected-active-foreground: #2A1E1C;
selected-normal-background: #CBA939;
selected-normal-foreground: #2A1E1C;
selected-urgent-background: #F25E5E;
selected-urgent-foreground: #2A1E1C;

background-color: #2A1E1C;
background: rgba(0,0,0,0.7);
foreground: #ABFCFE;
border-color: #CBA939;

color0: #524442;
color1: #725928;
color2: #B31F49;
color3: #B64646;
color4: #997F2A;
color5: #BA6F43;
color6: #0AB8BE;
color7: #7EF2F6;
